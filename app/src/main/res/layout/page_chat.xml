<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chatModel"
                style="@style/Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAllCaps="false" />

            <TextView
                style="@style/Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chat" />
        </LinearLayout>

        <ImageView
            android:id="@+id/newChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="New chat"
            android:padding="10dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />

        <LinearLayout
            android:id="@+id/chatEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_logo_tile"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_logo" />

            <TextView
                style="@style/Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Ask anything"
                android:textSize="26sp" />

            <TextView
                style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Your conversation stays between this phone and your own Ollama server." />
        </LinearLayout>
    </FrameLayout>

    <!-- slash command suggestions -->
    <LinearLayout
        android:id="@+id/cmdPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingVertical="6dp"
        android:visibility="gone" />

    <!-- attached image -->
    <LinearLayout
        android:id="@+id/attachRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/attachThumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_field"
            android:clipToOutline="true"
            android:contentDescription="Attached image"
            android:scaleType="centerCrop" />

        <TextView
            style="@style/Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Image attached" />

        <ImageView
            android:id="@+id/attachRemove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="Remove image"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/chatImage"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="Attach image"
            android:padding="10dp"
            android:src="@drawable/ic_image"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/chatInput"
            style="@style/Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Message, or type / for commands"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5" />

        <ImageView
            android:id="@+id/chatMic"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="Speak"
            android:padding="10dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/chatSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_send"
            android:contentDescription="Send"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            app:tint="@color/on_brand" />
    </LinearLayout>
</LinearLayout>
