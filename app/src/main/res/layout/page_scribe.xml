<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scribeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quill" />

        <TextView
            style="@style/Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Scribe" />

        <TextView
            style="@style/Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Write, then let your local model polish it." />

        <LinearLayout
            android:id="@+id/setupCard"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bring Quill into every app" />

            <TextView
                style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:text="Three quick steps. This card disappears once you're set." />

            <LinearLayout
                android:id="@+id/steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:padding="6dp">

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="top|start"
                android:hint="Write or paste something…"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingMultiplier="1.2"
                android:minLines="7"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/count"
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 words"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/clear"
                    style="@style/Btn.Text"
                    android:layout_height="36dp"
                    android:text="Clear" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Tools" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-20dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp" />
        </HorizontalScrollView>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginVertical="16dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/resultCard"
            style="@style/Card"
            android:background="@drawable/bg_result"
            android:visibility="gone">

            <TextView
                android:id="@+id/resultLabel"
                style="@style/Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Result" />

            <TextView
                android:id="@+id/output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/on_brand_container"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/copy"
                    style="@style/Btn.Text"
                    android:layout_marginEnd="8dp"
                    android:text="Copy"
                    android:textColor="@color/on_brand_container" />

                <TextView
                    android:id="@+id/use"
                    style="@style/Btn.Filled"
                    android:text="Use this" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
