<resources>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="Display">
        <item name="android:fontFamily">@font/dmserif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">34sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Eyebrow">
        <item name="android:fontFamily">@font/dmsans_semibold</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Heading">
        <item name="android:fontFamily">@font/dmsans_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Field" parent="android:Widget.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">13dp</item>
    </style>

    <style name="Btn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">22dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/dmsans_semibold</item>
    </style>
    <style name="Btn.Filled">
        <item name="android:background">@drawable/bg_btn_filled</item>
        <item name="android:textColor">@color/on_brand</item>
    </style>
    <style name="Btn.Tonal">
        <item name="android:background">@drawable/bg_btn_tonal</item>
        <item name="android:textColor">@color/on_brand_container</item>
    </style>
    <style name="Btn.Text">
        <item name="android:background">@drawable/bg_btn_text</item>
        <item name="android:textColor">@color/brand</item>
    </style>
</resources>
