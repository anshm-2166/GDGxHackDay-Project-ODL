<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape><corners android:radius="100dp" /><solid android:color="@color/field" /><size android:height="4dp" /></shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|start">
        <scale android:scaleWidth="100%">
            <shape><corners android:radius="100dp" /><solid android:color="@color/brand" /><size android:height="4dp" /></shape>
        </scale>
    </item>
</layer-list>
