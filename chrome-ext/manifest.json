{
  "manifest_version": 3,
  "name": "Quill - Private AI Writing Assistant",
  "short_name": "Quill",
  "version": "1.0.0",
  "description": "Grammarly-style grammar, clarity, tone and rewrite help in every text field, powered by Gemma, running on your own machine. Your writing never leaves your machine.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Quill",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "declarativeNetRequest", "contextMenus", "activeTab"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": [
        "lib/shared.js",
        "content/bridge.js",
        "content/fields.js",
        "content/ui.js",
        "content/app.js"
      ]
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "Open or close the Quill panel for the focused text field"
    },
    "accept-all": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Accept all Quill suggestions in the focused text field"
    }
  }
}
